# Server
PORT=3010
NODE_ENV=development

# MongoDB — dùng local hoặc Atlas
# Thay bằng URI thật của bạn. KHÔNG commit thông tin đăng nhập thật vào repo.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# JWT
# Bắt buộc >= 32 ký tự ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-chuoi-bi-mat-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=30d

# CORS — danh sách origin được phép gọi API (phân cách dấu phẩy, KHÔNG dấu / cuối)
# Production: liệt kê chính xác domain, KHÔNG dùng "*"
#   CORS_ORIGINS=https://admin.sunnydemo.site,https://sunnydemo.site
# Nếu đặt "*": mọi origin đều gọi được API và credentials bị tắt.
CORS_ORIGINS=

# Public base URL dùng khi build URL ảnh upload (ảnh hero, sản phẩm, document, …)
# Khi upload, backend sẽ lưu URL = ${PUBLIC_BASE_URL}/uploads/<filename> để trả về cho client.
# Nếu để trống, fallback về http://localhost:${PORT} (chỉ dùng được ở local).
# Production: đặt thành https://sunnydemo.site
PUBLIC_BASE_URL=https://sunnydemo.site

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Giới hạn riêng endpoint ghi lượt truy cập
VISIT_RATE_LIMIT_MAX=30

# TTL cho collection lượt truy cập (ngày). 0 = không giới hạn.
# Đặt 400 để vẫn tra cứu được dữ liệu 1 năm trong khi collection không phình vô hạn.
VISIT_TTL_DAYS=0

# Cron — giờ dọn events cũ (24h format). Mặc định 02:00
CLEANUP_CRON=0 2 * * *
