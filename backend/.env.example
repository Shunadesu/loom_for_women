# Server
PORT=3010
NODE_ENV=development

# MongoDB — dùng local hoặc Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/loom_for_women

# JWT
JWT_SECRET=thay-chuoi-bi-mat-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=30d

# CORS — danh sách origin được phép gọi API (phân cách dấu phẩy)
CORS_ORIGINS=http://localhost:3011,http://localhost:3012

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Cron — giờ dọn events cũ (24h format). Mặc định 02:00
CLEANUP_CRON=0 2 * * *