# Development: Vite proxy che /api calls, ảnh load trực tiếp từ backend
# - VITE_BACKEND_ORIGIN: backend origin cho Vite proxy (mặc định localhost:3010)
# - VITE_API_URL: để '/api' để đi qua proxy, che URL production
# Backend trả URL ảnh tuyệt đối (https://sunnydemo.site/uploads/...), không cần VITE_PUBLIC_BASE_URL

VITE_BACKEND_ORIGIN=http://localhost:3010
VITE_API_URL=/api
