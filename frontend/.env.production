# Production: trỏ thẳng về backend deploy thật (sunnydemo.site / VPS).
# - VITE_API_URL: base cho mọi request API (axios baseURL).
# - VITE_PUBLIC_BASE_URL: base cho ảnh upload (/uploads/...).
#   Đặt cùng domain với backend (bỏ /api ở cuối) để ảnh load đúng khi
#   frontend được deploy ở domain khác.
VITE_API_URL=https://sunnydemo.site/api
VITE_PUBLIC_BASE_URL=https://sunnydemo.site
